generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  email    String @unique
  password String
  notes    Note[]

  @@map("users")
}

model Note {
  id       String @id @default(uuid()) @db.Uuid
  title    String
  content  String
  userId   String @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notes")
}
